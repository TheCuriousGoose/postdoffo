APP_NAME=PostDoffo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Off by default for self-hosted clones: skips the marketing homepage,
# comparison pages, import guide, self-hosting pitch and blog, and blocks
# all crawling in robots.txt. The hosted deployment at postdoffo.nl sets
# this to true.
MARKETING_PAGES_ENABLED=false

# Requests are fired by the server, so by default it refuses targets on private,
# loopback and link-local addresses — otherwise any account could read a cloud
# metadata endpoint or an internal admin panel through it. Hosts ending in
# .test/.local/.localhost are unaffected: those are sent from the browser.
# Set this to false on a self-hosted install that exists to test services on its
# own network.
REQUEST_BLOCK_PRIVATE_HOSTS=true

# Requests fired per minute, per user.
REQUEST_RATE_LIMIT_PER_MINUTE=120

# Largest file that can be attached to a form-data body, in kilobytes. PHP's own
# upload_max_filesize and post_max_size have to allow at least as much.
REQUEST_MAX_UPLOAD_KILOBYTES=25600

# --- MCP server -------------------------------------------------------------
# The MCP server at /mcp lets an AI assistant work in a user's workspaces. It is
# always registered; nothing below is needed to use it over OAuth.

# Which hosts an OAuth client may name as its redirect URI. "*" lets any client
# register itself, which is what public MCP clients expect. On a private install
# you can narrow it to a comma-separated list, e.g.
# MCP_REDIRECT_DOMAINS=https://claude.ai,https://cursor.com
MCP_REDIRECT_DOMAINS=*

# Only for the stdio transport (`php artisan mcp:start postdoffo`), which has no
# HTTP request to read a bearer token from. Normally passed per-process by the
# MCP client rather than set here. Issue one with `php artisan mcp:token {user}`.
# POSTDOFFO_MCP_TOKEN=

# How much of a response body a tool returns before it is truncated, and how many
# requests one run_collection call will fire.
MCP_MAX_RESPONSE_CHARACTERS=20000
MCP_MAX_REQUESTS_PER_RUN=50

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI="${APP_URL}/auth/github/callback"

VITE_APP_NAME="${APP_NAME}"
